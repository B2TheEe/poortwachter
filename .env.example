# Kopieer dit bestand naar .env en vul je eigen waarden in.
# .env staat in .gitignore en komt dus niet op GitHub.

# Wachtwoorden per level (één woord, hoofdletters maakt niet uit)
POORTWACHTER_PW_1=
POORTWACHTER_PW_2=
POORTWACHTER_PW_3=
POORTWACHTER_PW_4=
POORTWACHTER_PW_5=
POORTWACHTER_PW_6=
POORTWACHTER_PW_7=

# Model: ollama (standaard), openai, anthropic of mock
LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Vaste sleutel voor sessies (genereer met: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=
